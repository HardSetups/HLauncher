{
  "name": "hlauncher",
  "private": true,
  "version": "1.0.0-alpha.3",
  "main": "electron/main.cjs",
  "author": "HLauncher",
  "description": "HLauncher — oyuncu ve sunucu dostu Minecraft launcher",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env NODE_ENV=development node launch-electron.js\"",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node tests/unit.test.cjs",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --publish never",
    "dist:dir": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --dir --publish never"
  },
  "build": {
    "appId": "com.hlauncher.app",
    "productName": "HLauncher",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HLauncher",
      "artifactName": "HLauncher-Kurulum-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HardSetups",
        "repo": "HLauncher"
      }
    ]
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "adm-zip": "^0.6.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "minecraft-launcher-core": "^3.18.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "msmc": "^5.0.5",
    "vite": "^7.2.4",
    "wait-on": "^9.1.0"
  }
}
